{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Painel de trabalho durante incidente: metrica, log e traco na mesma tela, ligados por trace_id. A ordem dos paineis e a ordem em que a triagem acontece - do sinal agregado para o request individual, nunca o contrario. Dados sintetico.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": ["observabilidade"],
      "title": "Golden signals",
      "type": "link",
      "url": "/d/obs-golden-signals/golden-signals"
    },
    {
      "asDropdown": false,
      "icon": "doc",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "title": "Runbooks",
      "type": "link",
      "url": "https://github.com/jraalves/observability-golden-signals-stack/tree/main/runbooks"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "1. Latencia: p95 contra o objetivo",
      "description": "Primeira pergunta de um incidente de latencia: e degradacao ou e quebra? p50 junto com p95 responde; p95 sozinho nao.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "service:http_request_duration_seconds:p95_5m{service=~\"$service\", journey=~\"$journey\"}",
          "legendFormat": "{{service}} p95",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "service:http_request_duration_seconds:p50_5m{service=~\"$service\", journey=~\"$journey\"}",
          "legendFormat": "{{service}} p50"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:latency:objective_seconds{service=~\"$service\"}",
          "legendFormat": "{{service}} objetivo"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "stacking": { "mode": "none" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/objetivo/" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 4], "fill": "dash" } },
              { "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "1. Erros e traffic na mesma escala de tempo",
      "description": "Erro subindo com traffic subindo e capacidade; erro subindo com traffic plano e deploy ou dependencia. Os dois eixos ficam separados de proposito: taxa de erro e requests/s nao compartilham unidade.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "service:http_error_ratio:rate5m{service=~\"$service\", journey=~\"$journey\"}",
          "legendFormat": "{{service}} erro",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "service:http_requests:rate5m{service=~\"$service\", journey=~\"$journey\"}",
          "legendFormat": "{{service}} rps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "axisPlacement": "left", "stacking": { "mode": "none" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/rps/" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.drawStyle", "value": "bars" },
              { "id": "color", "value": { "fixedColor": "dark-gray", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "2. Logs de erro com link para o trace",
      "description": "O campo trace_id do log JSON e derivado por regex e vira link interno para o Tempo. Nao ha busca de texto entre servicos: a correlacao e por identificador, o que funciona quando a mensagem do erro muda.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=~\"$service\", environment=\"$environment\"} | json | level=\"error\" | route=~\"$route\"",
          "maxLines": 200
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "allowDisablingBalancing": false,
            "drillDownUrl": "",
            "showTime": true,
            "sortOrder": "Descending",
            "wrapLogMessage": true,
            "prettifyLogMessage": false,
            "enableLogDetails": true,
            "dedupStrategy": "none",
            "showLabels": false,
            "derivedFields": [
              {
                "name": "trace_id",
                "matcherType": "regex",
                "matcherRegex": "\"trace_id\":\"([0-9a-f]{32})\"",
                "replace": "",
                "unit": "short",
                "datasourceUid": "tempo",
                "internalLink": {
                  "datasourceUid": "tempo",
                  "query": "${__value.raw}",
                  "spanInfoPath": ""
                }
              }
            ]
          },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "showTimeOfLines": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLogDetails": true,
        "compactExpandedByDefault": true,
        "showLabels": false
      }
    },
    {
      "id": 4,
      "type": "traces",
      "title": "3. Tracos com erro (TraceQL)",
      "description": "Busca nativa do Tempo por span de servidor com status de erro. Filtrar por atributo de resource em vez de texto e o que torna a busca viavel com volume alto.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "list",
          "query": "{  .kind = 2 && status.code = 2 }",
          "serviceNames": [],
          "filters": [],
          "spanName": "",
          "minDuration": "0s",
          "maxDuration": "0s",
          "limit": 20,
          "take": 20,
          "grouping": "none"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "showSubGraphs": false, "compact": true }
    },
    {
      "id": 5,
      "type": "table",
      "title": "2. Top erros por rota e status",
      "description": "Corta a lista de hipoteses: se 502 domina, o problema e do lado de fora; se 503 domina, provavelmente e capacidade ou deploy.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, route:http_errors:rate5m{service=~\"$service\", journey=~\"$journey\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "renameByName": { "Value": "erros/s", "route": "rota", "service": "servico", "status": "status", "journey": "jornada" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "erros/s" }]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "2. Arestas de service graph (lado Prometheus)",
      "description": "Serie gerada pelo metrics_generator do Tempo a partir dos spans. Serve para responder 'para onde foi a chamada?' sem abrir um trace por vez; a view interativa continua sendo a de Service Graph no Explore.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(12, sum by (client, server) (rate(trace_service_graph_requests_total[5m])))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "renameByName": { "Value": "chamadas/s", "client": "cliente", "server": "destino" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "chamadas/s" }]
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "4. Linha do tempo do trace pesquisado",
      "description": "Depois de escolher um trace_id (painel 3 ou 4), cola-se aqui a variavel trace_id: aparecem todos os logs de todos os servicos daquele request, na ordem do relogio. E o passo que fecha a hipotese.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=~\"$service\", environment=\"$environment\"} | json | trace_id=~\"$trace_id\"",
          "maxLines": 500
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "showTime": true,
            "sortOrder": "Ascending",
            "wrapLogMessage": false,
            "enableLogDetails": true,
            "dedupStrategy": "none",
            "showLabels": true,
            "derivedFields": [
              {
                "name": "trace_id",
                "matcherType": "regex",
                "matcherRegex": "\"trace_id\":\"([0-9a-f]{32})\"",
                "datasourceUid": "tempo",
                "internalLink": {
                  "datasourceUid": "tempo",
                  "query": "${__value.raw}",
                  "spanInfoPath": ""
                }
              }
            ]
          },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "showTimeOfLines": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "showLogDetails": true,
        "showLabels": true
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["observabilidade", "incidente", "correlacao", "sintetico"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Servico",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": ["Todos"], "value": ["$__all"] },
        "sort": 1
      },
      {
        "name": "journey",
        "label": "Jornada",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total{service=~\"$service\"}, journey)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": ["Todos"], "value": ["$__all"] },
        "sort": 1
      },
      {
        "name": "route",
        "label": "Rota",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total{service=~\"$service\"}, route)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": ["Todos"], "value": ["$__all"] }
      },
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "custom",
        "query": "local-sintetico",
        "current": { "text": "local-sintetico", "value": "local-sintetico" },
        "options": [{ "text": "local-sintetico", "value": "local-sintetico", "selected": true }]
      },
      {
        "name": "trace_id",
        "label": "trace_id (regex)",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "description": "Cole aqui um trace_id copiado do log ou do Tempo. Vazio = todos."
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["30s", "1m", "5m"] },
  "timezone": "America/Sao_Paulo",
  "title": "Correlacao de incidente: metrica, log e trace",
  "uid": "obs-correlacao",
  "version": 1,
  "weekStart": ""
}
