    {
      "id": 11,
      "type": "table",
      "title": "Decisao por servico: budget, burn e volume",
      "description": "A tabela existe para responder a uma pergunta de gestao: onde investir. Queima alta com volume alto e prioridade; queima alta com volume baixo e ruido de janela curta.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:availability:burn_rate:24h{service=~\"$service\"}",
