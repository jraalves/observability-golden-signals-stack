  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Burn rate de disponibilidade (1h / 6h / 24h / 14d)",
      "description": "1x e o ritmo sustentavel: acima disso o budget esta sendo consumido mais rapido do que existe. As linhas de threshold batem com os alertas de prometheus/rules/slo-burn-rate.yml: 3x vira ticket, 6x pagina atrasada, 14,4x pagina agora.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:availability:burn_rate:1h{service=~\"$service\"}",
          "legendFormat": "{{service}} 1h"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:availability:burn_rate:6h{service=~\"$service\"}",
          "legendFormat": "{{service}} 6h"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:availability:burn_rate:24h{service=~\"$service\"}",
          "legendFormat": "{{service}} 24h"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:availability:burn_rate:14d{service=~\"$service\"}",
          "legendFormat": "{{service}} 14d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "stacking": { "mode": "none" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
